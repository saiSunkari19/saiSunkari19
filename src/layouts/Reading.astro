---
// Single-column reading layout for the Writing pages: topline header,
// a narrow 760px column, and the colophon. Wraps the thin Base shell.
import Base from './Base.astro';
import Nav from '../components/Nav.astro';

export interface Props {
  title?: string;
  description?: string;
  image?: string;
  type?: string;
}
const { title, description, image, type } = Astro.props;
const year = new Date().getFullYear();
---
<Base title={title} description={description} image={image} type={type}>
  <Fragment slot="head"><slot name="head" /></Fragment>

  <div class="page">
    <Nav />
    <main id="main">
      <slot />
    </main>
    <footer class="colophon">
      <span>© {year} Sai Krishna Sunkari · Blockchain Architect</span>
      <span>Hyderabad, India · UTC+5:30</span>
    </footer>
  </div>
</Base>
