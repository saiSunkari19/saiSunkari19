---
import { getCollection } from 'astro:content';
import Reading from '../layouts/Reading.astro';
import { MEDIUM_HANDLE } from '../data/posts';
import { fetchMediumPosts } from '../lib/feeds';

type Source = 'x' | 'medium' | 'none';
interface Item {
  title: string;
  date: string;
  excerpt: string;
  source: Source;
  href: string;
  internal: boolean;
  cover?: string;
  readMins?: number;
}

// Self-hosted posts (authored via /admin) — link internally.
const localPosts: Item[] = (await getCollection('blog', ({ data }) => !data.draft)).map((p) => ({
  title: p.data.title,
  date: new Date(p.data.date).toISOString(),
  excerpt: p.data.excerpt ?? '',
  source: p.data.originalSource,
  href: `/writing/${p.id}`,
  internal: true,
  cover: p.data.cover,
}));

// Medium posts (auto-fetched at build) — link out.
const mediumPosts: Item[] = (await fetchMediumPosts(MEDIUM_HANDLE)).map((p) => ({
  title: p.title,
  date: p.date,
  excerpt: p.excerpt,
  source: 'medium',
  href: p.url,
  internal: false,
  readMins: p.readMins,
}));

const all: Item[] = [...localPosts, ...mediumPosts].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const badge = (s: Source) => (s === 'medium' ? 'MEDIUM' : s === 'x' ? 'X' : 'ARTICLE');
const readLabel = (it: Item) =>
  it.internal ? 'Read article →' : `Read on ${it.source === 'medium' ? 'Medium' : 'X'} ↗`;
const linkAttrs = (it: Item) => (it.internal ? {} : { target: '_blank', rel: 'noopener' });
---
<Reading
  title="Writing · Sai Krishna Sunkari"
  description="Essays and notes on blockchain architecture, Cosmos SDK, AI agents and the protocols they transact on, written by Sai Krishna Sunkari."
>
  <h1 class="statement">Notes on protocols, agents &amp; the systems between them.</h1>
  <p class="standfirst">
    Long-form pieces I've published here, with the originals on X and Medium where they first appeared.
  </p>

  <section class="group" aria-labelledby="g-articles">
    <div class="group-head">
      <span class="sec">§01</span><h2 class="group-title" id="g-articles">Articles</h2>
      {all.length > 0 && <span class="group-note">{all.length}</span>}
    </div>

    {all.length === 0 ? (
      <p class="entry-body" style="padding-left:var(--indent)">No posts yet — check back soon.</p>
    ) : (
      <div class="entries">
        {all.map((p) => (
          <article class="entry">
            <div class="entry-head">
              <a class="t label-link" href={p.href} {...linkAttrs(p)}>{p.title}</a>
              <span class="leader" aria-hidden="true"></span>
              <span class="yr">{fmtDate(p.date)}</span>
            </div>
            {p.excerpt && <p class="entry-body">{p.excerpt}</p>}
            <p class="entry-links">
              <a href={p.href} {...linkAttrs(p)}>{readLabel(p)}</a>
              <span class="src"> · {badge(p.source)}{p.readMins ? ` · ${p.readMins} min` : ''}</span>
            </p>
          </article>
        ))}
      </div>
    )}
  </section>

  <p style="font-family:var(--mono);font-size:12.5px;margin-top:clamp(32px,6vw,52px);">
    <a href="/" style="color:var(--muted);text-decoration:none;">← Back to home</a>
  </p>
</Reading>

<style>
  .entry-links .src { color: var(--faint); }
</style>
