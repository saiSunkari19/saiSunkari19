---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { MEDIUM_HANDLE } from '../data/posts';
import { fetchMediumPosts } from '../lib/feeds';

type Source = 'x' | 'medium' | 'none';
interface Item {
  title: string;
  date: string;
  excerpt: string;
  source: Source;
  href: string;
  internal: boolean;
  cover?: string;
  readMins?: number;
}

// Self-hosted posts (authored via /admin) — link internally.
const localPosts: Item[] = (await getCollection('blog', ({ data }) => !data.draft)).map((p) => ({
  title: p.data.title,
  date: new Date(p.data.date).toISOString(),
  excerpt: p.data.excerpt ?? '',
  source: p.data.originalSource,
  href: `/writing/${p.id}`,
  internal: true,
  cover: p.data.cover,
}));

// Medium posts (auto-fetched at build) — link out.
const mediumPosts: Item[] = (await fetchMediumPosts(MEDIUM_HANDLE)).map((p) => ({
  title: p.title,
  date: p.date,
  excerpt: p.excerpt,
  source: 'medium',
  href: p.url,
  internal: false,
  readMins: p.readMins,
}));

const all: Item[] = [...localPosts, ...mediumPosts].sort(
  (a, b) => new Date(b.date).getTime() - new Date(a.date).getTime(),
);
const [featured, ...rest] = all;

const fmtDate = (iso: string) =>
  new Date(iso).toLocaleDateString('en-US', { year: 'numeric', month: 'short', day: 'numeric' });
const badge = (s: Source) => (s === 'medium' ? 'MEDIUM' : s === 'x' ? 'X' : 'ARTICLE');
const readLabel = (it: Item) =>
  it.internal ? 'Read article →' : `Read on ${it.source === 'medium' ? 'Medium' : 'X'} ↗`;
const linkAttrs = (it: Item) => (it.internal ? {} : { target: '_blank', rel: 'noopener' });
---
<Base
  title="Writing — Sai Krishna Sunkari"
  description="Essays and notes on blockchain architecture, Cosmos SDK, AI agents and the protocols they transact on — by Sai Krishna Sunkari."
>
  <section class="section">
    <div class="wrap writing">
      <div data-reveal class="eyebrow">Writing</div>
      <h1 data-reveal data-delay="80" class="writing-h">Notes on protocols, agents &amp; the systems between them.</h1>
      <p data-reveal data-delay="140" class="writing-lead lead">
        Long-form pieces — published here, with the originals on X and Medium where they first appeared.
      </p>

      {all.length === 0 ? (
        <p class="empty lead">No posts yet — check back soon.</p>
      ) : (
        <>
          {featured && (
            <a data-reveal data-delay="180" href={featured.href} {...linkAttrs(featured)} class="featured">
              {featured.cover && <img src={featured.cover} alt={featured.title} class="featured-cover" />}
              <div class="featured-body">
                <div class="meta">
                  <span class={`pill pill-${featured.source}`}>{badge(featured.source)}</span>
                  <span>{fmtDate(featured.date)}</span>
                  {featured.readMins && <span>· {featured.readMins} min read</span>}
                </div>
                <h2 class="featured-title">{featured.title}</h2>
                {featured.excerpt && <p class="featured-excerpt lead">{featured.excerpt}</p>}
                <span class="read">{readLabel(featured)}</span>
              </div>
            </a>
          )}

          <div class="list">
            {rest.map((p, i) => (
              <a data-reveal data-delay={(i % 4) * 60} href={p.href} {...linkAttrs(p)} class="post">
                <div class="post-main">
                  <div class="meta">
                    <span class={`pill pill-${p.source}`}>{badge(p.source)}</span>
                    <span>{fmtDate(p.date)}</span>
                    {p.readMins && <span>· {p.readMins} min read</span>}
                  </div>
                  <h3 class="post-title">{p.title}</h3>
                  {p.excerpt && <p class="post-excerpt lead">{p.excerpt}</p>}
                </div>
                <span class="post-arrow" aria-hidden="true">{p.internal ? '→' : '↗'}</span>
              </a>
            ))}
          </div>
        </>
      )}

      <a data-reveal href="/#work" class="back">← Back to work</a>
    </div>
  </section>
</Base>

<style>
  .writing { padding-top: 90px; padding-bottom: 80px; }
  .writing-h {
    font-family: var(--f-serif); font-weight: 300; font-size: clamp(34px, 6vw, 52px);
    line-height: 1.05; letter-spacing: -1px; color: var(--head); margin: 0 0 22px; max-width: 720px;
  }
  .writing-lead { font-size: 18px; line-height: 1.6; color: var(--lead); margin: 0 0 56px; max-width: 560px; }
  .empty { color: var(--body); }

  .meta {
    display: flex; align-items: center; gap: 10px; flex-wrap: wrap;
    font-family: var(--f-mono); font-size: 10.5px; letter-spacing: .5px; color: var(--dim);
  }
  .pill { font-family: var(--f-mono); font-size: 9px; letter-spacing: 1.5px; border-radius: 20px; padding: 3px 9px; }
  .pill-medium { color: var(--web3-text); border: 1px solid var(--web3-line); }
  .pill-x { color: var(--web2-text); border: 1px solid var(--web2-line); }
  .pill-none { color: var(--gold); border: 1px solid #c9a86a44; }

  /* featured (one hero) */
  .featured {
    display: block; text-decoration: none; color: inherit;
    border: 1px solid var(--line); border-radius: 6px; overflow: hidden; margin-bottom: 14px;
    background: var(--card); transition: background .3s, border-color .3s, transform .3s;
  }
  .featured:hover { background: var(--card-hover); border-color: var(--line-2); transform: translateY(-3px); }
  .featured-cover { display: block; width: 100%; height: 280px; object-fit: cover; border-bottom: 1px solid var(--line); }
  .featured-body { padding: 32px 36px; }
  .featured-title {
    font-family: var(--f-serif); font-weight: 400; font-size: clamp(26px, 4vw, 34px);
    line-height: 1.1; letter-spacing: -.5px; color: var(--head); margin: 16px 0 12px;
    overflow-wrap: anywhere; word-break: break-word;
  }
  .featured-excerpt { font-size: 17px; line-height: 1.6; color: var(--body); margin: 0 0 20px; max-width: 640px; }
  .read { font-family: var(--f-mono); font-size: 11px; letter-spacing: .5px; color: var(--gold); }

  /* list */
  .list { border-top: 1px solid var(--line); }
  .post {
    display: flex; align-items: flex-start; justify-content: space-between; gap: 24px;
    padding: 28px 4px; border-bottom: 1px solid var(--line);
    text-decoration: none; color: inherit; transition: padding-left .3s;
  }
  .post:hover { padding-left: 14px; }
  .post:hover .post-arrow { color: var(--gold); transform: translate(2px, -2px); }
  .post-title { font-family: var(--f-serif); font-weight: 500; font-size: 22px; line-height: 1.2; color: var(--head-2); margin: 12px 0 8px; overflow-wrap: anywhere; word-break: break-word; }
  .post:hover .post-title { color: var(--gold-hi); }
  .post-excerpt { font-size: 15.5px; line-height: 1.55; color: var(--body-2); margin: 0; max-width: 620px; }
  .post-arrow { font-family: var(--f-mono); font-size: 18px; color: var(--dim); transition: color .3s, transform .3s; padding-top: 28px; }

  .back {
    display: inline-block; margin-top: 48px;
    font-family: var(--f-mono); font-size: 12px; letter-spacing: .5px; color: var(--nav);
    text-decoration: none; transition: color .3s;
  }
  .back:hover { color: var(--gold); }

  @media (max-width: 560px) {
    .featured-body { padding: 24px 22px; }
    .featured-cover { height: 200px; }
    .post-arrow { display: none; }
  }
</style>
