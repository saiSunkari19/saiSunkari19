---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import profile from '../assets/sai-profile.png';
import { CALENDLY_URL } from '../data/site';
import { projects, projectStats, GROUP_LABEL } from '../data/projects';
import proofMatrix from '../data/proof-matrix.json';
import { slug } from '../lib/proof';
import ProofGraph from '../components/ProofGraph.astro';
import { roles } from '../data/timeline';
import { capabilities, recognition, education } from '../data/capabilities';

const email = 'saisunkari19@protonmail.com';
const ext = { target: '_blank', rel: 'noopener' };

// Two proof pillars lead. Featured systems = the strongest three; the rest
// follow as a compact "more systems" list. (Strategy: proof leads.)
const featuredNames = ['DegentsAI', 'Pexu AI', 'FreeFlix · OmniFlix'];
const featured = featuredNames
  .map((n) => projects.find((p) => p.name === n))
  .filter((p): p is (typeof projects)[number] => Boolean(p));
const more = projects.filter((p) => !featuredNames.includes(p.name));
// Mirrors the resume's three project sections, in the same order.
const grouped = (['oss', 'work', 'independent'] as const).map((g) => ({
  key: g,
  label: GROUP_LABEL[g],
  items: projects.filter((p) => p.group === g),
}));

function splitMeta(meta: string): { tech: string; year: string } {
  const parts = meta.split('·').map((s) => s.trim());
  const last = parts[parts.length - 1];
  if (/^\d{4}$/.test(last)) return { tech: parts.slice(0, -1).join(' · '), year: last };
  return { tech: meta, year: '' };
}

// Latest writing for the rail (self-hosted posts, newest first).
const latest = (await getCollection('blog', ({ data }) => !data.draft))
  .map((p) => ({ title: p.data.title, href: `/writing/${p.id}`, year: new Date(p.data.date).getFullYear() }))
  .sort((a, b) => b.year - a.year)
  .slice(0, 3);

const year = new Date().getFullYear();
---
<Base
  title="Sai Krishna Sunkari · AI × Blockchain Architect"
  description="Sai Krishna Sunkari is an AI × blockchain architect. Seven years shipping production systems across EVM, Cosmos, Sui, Aptos & Movement, now building autonomous AI agents and the on-chain rails they run on."
>
  <div class="hwrap">
    <div class="shell">

      <!-- ============================ CONTENT (LEFT) ============================ -->
      <main id="main" class="content">

        <!-- 0 · ORIENT -->
        <header class="orient">
          <p class="topline"><b>Sai Krishna Sunkari</b> · AI × Blockchain Architect · Builder &amp; Advisor</p>
          <h1>I architect AI agents and the decentralized systems they run on, and <span class="em">lead the teams that ship them.</span></h1>
          <p class="valueprop">The hard part is rarely the demo. It's getting the thing you believe in to hold up in production, and keeping a team moving once it does. That's the work I do. For seven years it was protocols across EVM, Cosmos, Sui, Aptos and Movement. Lately it's the AI agents that run on top of them, and the on-chain rails they trade and transact over.</p>
          <div class="cred">
            <span class="cred-stats"><b>{projectStats.total >= 13 ? '7' : '7'}&nbsp;yrs</b><span class="d" aria-hidden="true">·</span><b>10+&nbsp;chains</b><span class="d" aria-hidden="true">·</span><b>{projectStats.total}+&nbsp;systems</b><span class="d" aria-hidden="true">·</span><b>2&nbsp;awards</b></span>
            <span class="cred-eco">AI agents · EVM · Cosmos · Sui · Aptos · Movement</span>
          </div>
        </header>

        <!-- 1 · THE MAP — the first proof, before any claim about the work.
             It bleeds left to the page gutter and stops at the content column's
             hairline, so the pinned rail and its Book-a-call stay untouched. -->
        <section id="map" class="mapband" aria-label="Map of shipped work">
          <p class="map-lede">
            Every technology mapped to the projects that prove it, generated from
            project records rather than self-assessed. <a href="/proof">Read it as text →</a>
          </p>
          <div class="mapbleed">
            <ProofGraph variant="column" />
          </div>
        </section>

        <!-- What I do: the offer, above the proof pillars -->
        <section id="do" class="offer" aria-labelledby="do-h">
          <h2 id="do-h" class="offer-h">What I do</h2>
          <div class="offer-grid">
            <div class="offer-col">
              <span class="offer-rule" aria-hidden="true"></span>
              <h3 class="offer-t">AI agents</h3>
              <p class="offer-d">I build autonomous agents with LangGraph, CrewAI and Eliza, then wire them into MCP, A2A and Agent Commerce Protocol so they can actually act on-chain, not just talk about it.</p>
            </div>
            <div class="offer-col">
              <span class="offer-rule" aria-hidden="true"></span>
              <h3 class="offer-t">Decentralized systems</h3>
              <p class="offer-d">I design the protocols, DeFi primitives and token economics your product sits on, across EVM, Cosmos SDK app-chains, Sui, Aptos and Movement.</p>
            </div>
            <div class="offer-col">
              <span class="offer-rule" aria-hidden="true"></span>
              <h3 class="offer-t">Architecture &amp; leadership</h3>
              <p class="offer-d">I own the roadmap, the hiring and the delivery, from the first commit through scale, and I keep the standards high enough to survive an audit.</p>
            </div>
          </div>
        </section>

        <!-- PILLAR ONE · TRAJECTORY -->
        <section id="trajectory" class="pillar" aria-labelledby="traj-h">
          <div class="sec-head">
            <h2 id="traj-h">Trajectory</h2>
            <span class="count">7 years, one arc</span>
          </div>
          <p class="traj-frame">Seven years, one arc, from intern to architect to founder.</p>
          <div class="traj-list">
            {roles.map((r) => (
              <article class="traj-row">
                <div class="traj-top">
                  <span class="traj-role">{r.title}{r.sub && <span class="traj-co"> {r.sub}</span>}</span>
                  <span class="traj-years">{r.period}</span>
                </div>
                <p class="traj-desc">{r.body}</p>
              </article>
            ))}
          </div>
        </section>

        <!-- PILLAR TWO · SELECTED WORK -->
        <section id="work" class="pillar" aria-labelledby="work-h">
          <div class="sec-head">
            <h2 id="work-h">Work</h2>
            <span class="count">{projectStats.total} shipped · {projectStats.web3} web3 · {projectStats.web2} web2</span>
          </div>

          {grouped.map((g) => (
            <div class="wgroup">
              <p class="wgroup-label">{g.label}<span class="wgroup-n">{g.items.length}</span></p>
              <div class="more-list">
                {g.items.map((p) => {
                  const { tech, year: yr } = splitMeta(p.meta);
                  // Rows now open the project's own page rather than jumping
                  // straight out. The outbound link is still the first thing
                  // on that page, alongside the stack and the nearest work.
                  return (
                    <a class="more-row" href={`/projects/${slug(p.name)}`}>
                      <span class="more-name">{p.name}<span class="more-tag">{tech}{yr && ` · ${yr}`}</span></span>
                      <span class="more-desc">{p.blurb}</span>
                    </a>
                  );
                })}
              </div>
            </div>
          ))}
        </section>

        <!-- LIGHTER · Ventures -->

        <!-- LIGHTER · Capabilities -->
        <section id="stack" class="light" aria-labelledby="stack-h">
          <div class="sec-head"><h2 id="stack-h">Capabilities</h2></div>
          <dl class="caps">
            {capabilities.map((g) => (
              <div class="cap-row">
                <dt>{g.label}</dt>
                <dd>{g.items.join('  ·  ')}</dd>
              </div>
            ))}
          </dl>
        </section>

        <!-- LIGHTER · Proof matrix (generated from the private vault) -->
        <section id="proof" class="light" aria-labelledby="proof-h">
          <div class="sec-head">
            <h2 id="proof-h">Proof</h2>
            <span class="count">{proofMatrix.projectCount} shipped projects</span>
          </div>
          <p class="proof-note">What I build with, and the shipped projects behind each group. Counted from real work, not a self-assessment.</p>
          {proofMatrix.categories.map((c) => (
            <div class="pcat">
              <p class="pcat-head">{c.label}<span class="pcat-meta">{c.projects.length}&nbsp;projects{c.since ? ` · since ${c.since}` : ''}</span></p>
              <p class="pcat-tech">{c.tech.join('  ·  ')}</p>
              <p class="pcat-proj">{c.projects.join('  ·  ')}</p>
            </div>
          ))}
          <div class="pcat">
            <p class="pcat-head">Chains<span class="pcat-meta">{proofMatrix.chains.length}&nbsp;shipped on</span></p>
            <p class="pcat-tech">{proofMatrix.chains.map((c) => c.tech).join('  ·  ')}</p>
          </div>
          <p class="proof-more">
            <a href="/proof">Every technology mapped to the projects that prove it →</a>
          </p>
        </section>

        <!-- LIGHTER · Recognition + Education -->
        <section id="recognition" class="light" aria-labelledby="rec-h">
          <div class="sec-head"><h2 id="rec-h">Recognition &amp; education</h2></div>
          <ul class="rec-list">
            {recognition.map((r) => (
              <li class="rec-row"><span class="rec-t">{r.title}</span><span class="rec-s">{r.sub}</span></li>
            ))}
            <li class="rec-row"><span class="rec-t">{education.degree}</span><span class="rec-s">{education.detail}</span></li>
          </ul>
        </section>

        <footer class="colophon">
          <span>© {year} Sai Krishna Sunkari · AI × Blockchain Architect</span>
          <span>Hyderabad, India · UTC+5:30</span>
        </footer>

      </main>

      <!-- ============================ RAIL (RIGHT) ============================ -->
      <aside class="rail" aria-label="Actions and contact">
        <div class="rail-grid">

          <div class="rail-id">
            <Image src={profile} alt="Sai Krishna Sunkari" width={280} height={340} class="rail-photo" loading="eager" />
            <div class="rail-id-text">
              <span class="rail-name">Sai Krishna Sunkari</span>
              <span class="rail-role">AI × Blockchain Architect · Builder &amp; Advisor</span>
            </div>
          </div>

          <div class="book-block">
            <a class="book" href={CALENDLY_URL} {...ext}>Book a call <span class="arr" aria-hidden="true">→</span></a>
          </div>

          <div class="rail-block">
            <p class="rail-label">Latest writing</p>
            <div class="rail-posts">
              {latest.map((p) => (
                <a class="rail-post" href={p.href}>
                  <span class="t">{p.title}</span>
                  <span class="d">{p.year}</span>
                </a>
              ))}
            </div>
            <a class="all-writing" href="/writing">All writing →</a>
          </div>

          <div class="rail-block">
            <p class="rail-label">Contact</p>
            <div class="contact-list">
              <a href={`mailto:${email}`}>{email}</a>
              <a href="https://github.com/saiSunkari19" {...ext}>GitHub @saiSunkari19</a>
              <a href="https://www.linkedin.com/in/saisunkari19/" {...ext}>LinkedIn @saisunkari19</a>
              <a href="https://twitter.com/saisunkari19" {...ext}>X @saisunkari19</a>
              <span class="loc">Hyderabad · UTC+5:30</span>
            </div>
          </div>

        </div>
      </aside>

    </div>
  </div>

  <!-- slim sticky book bar (mobile only) -->
  <div class="mobile-bar">
    <a class="book" href={CALENDLY_URL} {...ext}>Book a call <span class="arr" aria-hidden="true">→</span></a>
  </div>
</Base>

<style>
  .hwrap {
    --rail: 290px;
    --gut: clamp(1.25rem, 4vw, 3.25rem);
    --hmaxw: 1180px;
    --z-sticky: 100; --z-bar: 200;
    max-width: var(--hmaxw);
    margin: 0 auto;
    padding: 0 var(--gut);
  }
  .shell { display: grid; grid-template-columns: minmax(0,1fr) var(--rail); align-items: start; }
  .content {
    min-width: 0;
    padding: clamp(2.5rem,5vw,4.5rem) clamp(1.75rem,3.5vw,3.5rem) 1rem 0;
    border-right: 1px solid var(--hair);
  }
  .rail {
    position: sticky; top: 0; align-self: start; z-index: var(--z-sticky);
    padding: clamp(2.5rem,5vw,4.5rem) 0 2.5rem clamp(1.75rem,3.5vw,3.25rem);
  }

  /* ---------- the map ---------- */
  .mapband { scroll-margin-top: 1rem; margin: clamp(2rem, 4vw, 3rem) 0 clamp(2.5rem, 5vw, 3.75rem); }
  /* Cancels .content's right padding so the band meets the rail hairline, and
     bleeds left by the wrap gutter to buy width where nothing else lives. */
  .mapbleed {
    margin-right: calc(-1 * clamp(1.75rem, 3.5vw, 3.5rem));
    margin-left: calc(-1 * var(--gut));
  }
  .map-lede {
    font-family: var(--mono); font-size: .72rem; color: var(--faint);
    line-height: 1.7; margin: 0 0 1rem; max-width: 60ch;
  }

  /* ---------- orient ---------- */
  .topline { font-family: var(--mono); font-size: .8125rem; color: var(--muted); letter-spacing: .02em; margin: 0 0 1.4rem; overflow-wrap: anywhere; }
  .topline b { color: var(--ink); font-weight: 500; }
  .orient { margin: 0 0 clamp(2.5rem,4.5vw,3.5rem); }
  h1 {
    font-weight: 700; font-size: clamp(1.85rem,1.25rem + 2.7vw,3.05rem);
    line-height: 1.05; letter-spacing: -.035em; color: var(--ink);
    margin: 0 0 1rem; text-wrap: balance; max-width: 19ch;
  }
  h1 .em { color: var(--accent-ink); }
  .valueprop { font-size: clamp(1.02rem,1rem + 0.4vw,1.18rem); line-height: 1.5; color: var(--ink-2); margin: 0 0 1.6rem; max-width: 58ch; text-wrap: pretty; }
  .cred { margin: 0; padding-top: 1.4rem; border-top: 1px solid var(--hair); display: flex; flex-wrap: wrap; align-items: baseline; gap: .5rem 1.2rem; overflow-wrap: anywhere; }
  .cred-stats { font-family: var(--mono); font-size: clamp(.95rem,.9rem + .25vw,1.08rem); color: var(--ink); }
  .cred-stats b { font-weight: 600; }
  .cred-stats .d { color: var(--hair-2); margin: 0 .5em; }
  .cred-eco { font-family: var(--mono); font-size: .78rem; color: var(--faint); letter-spacing: .02em; }

  /* ---------- What I do (distinct 3-up offer band) ---------- */
  .offer { margin: clamp(2.5rem,4.5vw,3.5rem) 0 0; padding-bottom: clamp(2rem,4vw,3rem); border-bottom: 1px solid var(--hair); }
  .offer-h { font-family: var(--mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .14em; color: var(--faint); font-weight: 400; margin: 0 0 1.5rem; }
  .offer-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 1.9rem; }
  .offer-rule { display: block; width: 26px; height: 2px; background: var(--ink); margin: 0 0 .85rem; }
  .offer-t { font-size: 1.05rem; font-weight: 700; letter-spacing: -.02em; color: var(--ink); margin: 0 0 .5rem; }
  .offer-d { font-size: .95rem; line-height: 1.5; color: var(--ink-2); margin: 0; }

  /* ---------- section heads ---------- */
  section { scroll-margin-top: 1.5rem; }
  .sec-head { display: flex; align-items: baseline; gap: .9rem; margin: 0 0 1.4rem; }
  .sec-head h2 { margin: 0; font-weight: 600; letter-spacing: -.02em; color: var(--ink); line-height: 1; }
  .sec-head .count { font-family: var(--mono); font-size: .75rem; color: var(--faint); letter-spacing: .02em; margin-left: auto; }

  /* ---------- two pillars ---------- */
  .pillar { margin-top: clamp(3rem,5vw,4.5rem); }
  .pillar .sec-head { margin-bottom: .4rem; padding-bottom: 1.15rem; border-bottom: 2px solid var(--ink); }
  .pillar .sec-head h2 { font-size: clamp(1.5rem,1.2rem + 1.4vw,1.95rem); font-weight: 700; letter-spacing: -.03em; }

  /* trajectory */
  .traj-frame { font-size: 1.05rem; line-height: 1.55; color: var(--ink-2); margin: 1.35rem 0 .4rem; max-width: 60ch; text-wrap: pretty; }
  .traj-row { padding: clamp(1.5rem,3vw,2.1rem) 0; border-bottom: 1px solid var(--hair); }
  .traj-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: .35rem 1rem; margin-bottom: .6rem; }
  .traj-role { font-size: clamp(1.12rem,1rem + .5vw,1.28rem); font-weight: 700; letter-spacing: -.02em; color: var(--ink); line-height: 1.2; }
  .traj-role .traj-co { font-size: .9rem; color: var(--muted); font-weight: 400; }
  .traj-years { margin-left: auto; font-family: var(--mono); font-size: .8rem; color: var(--faint); letter-spacing: .02em; white-space: nowrap; }
  .traj-desc { font-size: 1rem; line-height: 1.58; color: var(--ink-2); margin: 0; max-width: 66ch; text-wrap: pretty; }

  /* selected work */
  .feat { display: block; text-decoration: none; padding: clamp(1.6rem,3vw,2.3rem) 0; border-bottom: 1px solid var(--hair); transition: transform .4s cubic-bezier(.16,1,.3,1); }
  .feat-top { display: flex; flex-wrap: wrap; align-items: baseline; gap: .55rem 1rem; margin-bottom: .7rem; }
  .feat-name { font-size: clamp(1.28rem,1.1rem + .85vw,1.4rem); font-weight: 700; letter-spacing: -.025em; color: var(--ink); line-height: 1.05; transition: color .2s; }
  .feat-tag { font-family: var(--mono); font-size: .75rem; color: var(--muted); letter-spacing: .04em; }
  .feat-arrow { margin-left: auto; font-family: var(--mono); font-size: .9rem; color: var(--hair-2); transition: transform .4s cubic-bezier(.16,1,.3,1), color .2s; }
  .feat-blurb { font-size: 1.05rem; line-height: 1.55; color: var(--ink-2); margin: 0; max-width: 64ch; text-wrap: pretty; }
  .feat-outcome { display: inline-flex; align-items: center; gap: .5em; margin-top: .9rem; font-family: var(--mono); font-size: .8125rem; color: var(--accent-ink); font-weight: 500; }
  @media (hover:hover) {
    .feat:hover { transform: translateX(8px); }
    .feat:hover .feat-name { color: var(--accent-ink); }
    .feat:hover .feat-arrow { color: var(--accent); transform: translate(3px,-3px); }
  }

  .more { margin-top: clamp(1.8rem,3.5vw,2.5rem); }
  .more-label { font-family: var(--mono); font-size: .68rem; text-transform: uppercase; letter-spacing: .13em; color: var(--faint); margin: 0 0 .7rem; }
  .more-list { border-top: 1px solid var(--hair); }
  .more-row { display: grid; grid-template-columns: minmax(10rem,15rem) 1fr; gap: .4rem 1.4rem; align-items: baseline; padding: .85rem 0; border-bottom: 1px solid var(--hair); text-decoration: none; transition: background-color .2s; }
  @media (hover:hover) { a.more-row:hover { background: var(--paper-2); } a.more-row:hover .more-name { color: var(--accent-ink); } }
  .more-name { font-weight: 600; font-size: .975rem; color: var(--ink); letter-spacing: -.01em; transition: color .2s; }
  .more-tag { display: block; font-family: var(--mono); font-size: .7rem; color: var(--faint); letter-spacing: .03em; margin-top: .15rem; }
  .more-desc { font-size: .925rem; color: var(--muted); line-height: 1.45; }

  /* ---------- lighter sections ---------- */
  .light { margin-top: clamp(2.5rem,4.5vw,3.75rem); }
  .light .sec-head { margin-bottom: 1.1rem; }
  .light .sec-head h2 { font-size: .95rem; font-weight: 600; color: var(--ink-2); }

  .vent-list { border-top: 1px solid var(--hair); }
  .vent-row { display: grid; grid-template-columns: 1fr auto; gap: .4rem 1rem; align-items: baseline; padding: .7rem 0; border-bottom: 1px solid var(--hair); font-size: .95rem; text-decoration: none; transition: background-color .2s; }
  @media (hover:hover) { .vent-row:hover { background: var(--paper-2); } .vent-row:hover .vent-name { color: var(--accent-ink); } }
  .vent-name { color: var(--ink); font-weight: 600; letter-spacing: -.01em; transition: color .2s; }
  .vent-role { color: var(--muted); font-weight: 400; margin-left: .5em; font-size: .85rem; }
  .vent-year { font-family: var(--mono); font-size: .75rem; color: var(--faint); letter-spacing: .02em; }

  .caps { margin: 0; border-top: 1px solid var(--hair); padding-top: 1rem; display: flex; flex-direction: column; gap: .65rem; }
  .cap-row { display: grid; grid-template-columns: 9rem 1fr; gap: .3rem 1.2rem; align-items: baseline; }
  .cap-row dt { font-family: var(--mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .08em; color: var(--faint); }
  .cap-row dd { margin: 0; font-family: var(--mono); font-size: .8125rem; color: var(--ink-2); line-height: 1.7; }

  .wgroup { margin-top: 1.8rem; }
  .wgroup:first-of-type { margin-top: .4rem; }
  .wgroup-label { font-family: var(--mono); font-size: .72rem; text-transform: uppercase; letter-spacing: .1em;
    color: var(--faint); margin: 0 0 .3rem; display: flex; align-items: baseline; gap: .5rem; }
  .wgroup-n { font-variant-numeric: tabular-nums; }

  .proof-note { font-family: var(--mono); font-size: .76rem; color: var(--faint); margin: 0 0 1.2rem; line-height: 1.6; }
  .proof-more { font-family: var(--mono); font-size: .76rem; margin: 1.1rem 0 0; }
  .pcat { padding: .85rem 0; border-top: 1px solid var(--hair); }
  .pcat:last-of-type { border-bottom: 1px solid var(--hair); }
  .pcat-head { display: flex; flex-wrap: wrap; align-items: baseline; gap: .2rem .8rem; margin: 0 0 .35rem;
    font-weight: 600; font-size: .95rem; color: var(--ink); }
  .pcat-meta { font-family: var(--mono); font-size: .7rem; text-transform: uppercase; letter-spacing: .06em; color: var(--faint); font-weight: 400; }
  .pcat-tech { margin: 0 0 .25rem; font-family: var(--mono); font-size: .8rem; color: var(--ink-2); line-height: 1.75; }
  .pcat-proj { margin: 0; font-family: var(--mono); font-size: .74rem; color: var(--faint); line-height: 1.7; }

  .rec-list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--hair); }
  .rec-row { display: flex; flex-wrap: wrap; align-items: baseline; gap: .3rem 1rem; padding: .7rem 0; border-bottom: 1px solid var(--hair); }
  .rec-t { font-weight: 600; font-size: .95rem; color: var(--ink); }
  .rec-s { font-family: var(--mono); font-size: .76rem; color: var(--faint); letter-spacing: .01em; }

  .colophon {
    margin-top: clamp(3rem,6vw,5rem); padding-top: 1.4rem; border-top: 1px solid var(--hair);
    display: flex; flex-wrap: wrap; justify-content: space-between; gap: 8px 24px;
    font-family: var(--mono); font-size: 11.5px; color: var(--faint); letter-spacing: .01em;
  }

  /* ---------- rail ---------- */
  .rail-id { margin-bottom: 1.6rem; }
  .rail-photo { display: block; width: 116px; height: 116px; object-fit: cover; object-position: center 18%; border: 1px solid var(--hair-2); border-radius: 50%; margin-bottom: .95rem; }
