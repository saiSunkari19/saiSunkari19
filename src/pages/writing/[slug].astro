---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, cover, excerpt, originalSource, originalUrl, tags } = post.data;

const fmtDate = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const sourceName = originalSource === 'medium' ? 'Medium' : originalSource === 'x' ? 'X' : '';
---
<Base title={`${title} — Sai Krishna Sunkari`} description={excerpt ?? title} type="article">
  <article class="section">
    <div class="wrap post">
      <a href="/writing" class="back">← All writing</a>

      <header class="post-head">
        {tags.length > 0 && <div class="tags-row">{tags.map((t) => <span class="tag">{t}</span>)}</div>}
        <h1 class="post-title">{title}</h1>
        <div class="post-meta">
          <time datetime={new Date(date).toISOString()}>{fmtDate(date)}</time>
        </div>
      </header>

      {originalUrl && sourceName && (
        <a href={originalUrl} target="_blank" rel="noopener" class="origin">
          <span class={`pill pill-${originalSource}`}>{sourceName.toUpperCase()}</span>
          Originally posted on {sourceName}
          <span class="origin-arrow">↗</span>
        </a>
      )}

      {cover && <img src={cover} alt={title} class="cover" loading="eager" />}

      <div class="prose">
        <Content />
      </div>

      <footer class="post-foot">
        {originalUrl && sourceName && (
          <p class="foot-note">
            This piece was originally posted on {sourceName}.
            <a href={originalUrl} target="_blank" rel="noopener">Read it there ↗</a>
          </p>
        )}
        <a href="/writing" class="back">← All writing</a>
      </footer>
    </div>
  </article>
</Base>

<style>
  .post { padding-top: 56px; padding-bottom: 90px; max-width: 760px; }
  .back {
    display: inline-block;
    font-family: var(--f-mono); font-size: 12px; letter-spacing: .5px; color: var(--nav);
    text-decoration: none; transition: color .3s;
  }
  .back:hover { color: var(--gold); }

  .post-head { margin: 28px 0 24px; }
  .tags-row { display: flex; flex-wrap: wrap; gap: 7px; margin-bottom: 18px; }
  .post-title {
    font-family: var(--f-serif); font-weight: 400; font-size: clamp(30px, 5.5vw, 46px);
    line-height: 1.08; letter-spacing: -.8px; color: var(--head); margin: 0 0 16px;
    overflow-wrap: anywhere; word-break: break-word;
  }
  .post-meta { font-family: var(--f-mono); font-size: 11.5px; letter-spacing: .5px; color: var(--dim); }

  .origin {
    display: inline-flex; align-items: center; gap: 10px;
    font-family: var(--f-mono); font-size: 12px; letter-spacing: .3px; color: var(--body);
    text-decoration: none;
    border: 1px solid var(--line-2); border-radius: 30px; padding: 8px 16px; margin-bottom: 32px;
    transition: border-color .3s, color .3s;
  }
  .origin:hover { border-color: var(--gold); color: var(--head-2); }
  .origin-arrow { color: var(--gold); }
  .pill { font-family: var(--f-mono); font-size: 9px; letter-spacing: 1.5px; border-radius: 20px; padding: 3px 9px; }
  .pill-x { color: var(--web2-text); border: 1px solid var(--web2-line); }
  .pill-medium { color: var(--web3-text); border: 1px solid var(--web3-line); }
  .pill-none { color: var(--dim); border: 1px solid var(--line-2); }

  .cover {
    display: block; width: 100%; height: auto; border-radius: 6px;
    border: 1px solid var(--line); margin: 0 0 40px;
  }

  /* ---- article body ---- */
  .prose { font-family: var(--f-read); font-weight: 300; font-size: 19px; line-height: 1.7; color: var(--body); }
  .prose :global(p) { margin: 0 0 22px; }
  .prose :global(h2) {
    font-family: var(--f-serif); font-weight: 400; font-size: 28px; line-height: 1.2;
    color: var(--head); letter-spacing: -.4px; margin: 44px 0 16px;
  }
  .prose :global(h3) {
    font-family: var(--f-sans); font-weight: 600; font-size: 20px; color: var(--head-2); margin: 32px 0 12px;
  }
  .prose :global(a) { color: var(--gold); text-decoration: none; border-bottom: 1px solid #c9a86a55; }
  .prose :global(a:hover) { border-bottom-color: var(--gold); }
  .prose :global(strong) { color: var(--head-2); font-weight: 600; }
  .prose :global(em) { color: var(--lead); }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 22px; padding-left: 22px; }
  .prose :global(li) { margin: 0 0 8px; }
  .prose :global(img) { display: block; width: 100%; height: auto; border-radius: 6px; border: 1px solid var(--line); margin: 28px 0; }
  .prose :global(blockquote) {
    margin: 0 0 24px; padding: 4px 0 4px 22px; border-left: 2px solid var(--gold);
    color: var(--body-2); font-style: italic;
  }
  .prose :global(code) {
    font-family: var(--f-mono); font-size: .85em; background: var(--card);
    border: 1px solid var(--line); border-radius: 4px; padding: 2px 6px;
  }
  .prose :global(pre) {
    background: var(--bg-3); border: 1px solid var(--line); border-radius: 6px;
    padding: 18px 20px; overflow-x: auto; margin: 0 0 24px;
  }
  .prose :global(pre code) { background: none; border: 0; padding: 0; font-size: 13.5px; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--line); margin: 36px 0; }

  .post-foot { margin-top: 48px; padding-top: 28px; border-top: 1px solid var(--line); }
  .foot-note { font-family: var(--f-read); font-size: 15px; color: var(--dim); margin: 0 0 20px; }
  .foot-note a { color: var(--gold); text-decoration: none; margin-left: 6px; }
  .foot-note a:hover { color: var(--gold-hi); }
</style>
