---
import { getCollection, render } from 'astro:content';
import Reading from '../../layouts/Reading.astro';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, date, cover, excerpt, originalSource, originalUrl, tags } = post.data;

const fmtDate = (d: Date) =>
  new Date(d).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
const sourceName = originalSource === 'medium' ? 'Medium' : originalSource === 'x' ? 'X' : '';

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const blogSchema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: title,
  datePublished: new Date(date).toISOString(),
  description: excerpt ?? title,
  ...(cover ? { image: cover } : {}),
  author: { '@type': 'Person', name: 'Sai Krishna Sunkari', url: Astro.site?.href },
  publisher: { '@type': 'Person', name: 'Sai Krishna Sunkari' },
  mainEntityOfPage: { '@type': 'WebPage', '@id': canonical },
  url: canonical,
  ...(tags.length ? { keywords: tags.join(', ') } : {}),
};
---
<Reading title={`${title} · Sai Krishna Sunkari`} description={excerpt ?? title} image={cover} type="article">
  <script type="application/ld+json" set:html={JSON.stringify(blogSchema)} slot="head" />
  <article>
    <p class="backline"><a href="/writing">← All writing</a></p>

    <header class="post-head">
      {tags.length > 0 && <div class="tags-row">{tags.map((t) => <span class="tag">{t}</span>)}</div>}
      <h1 class="post-title">{title}</h1>
      <div class="post-meta">
        <time datetime={new Date(date).toISOString()}>{fmtDate(date)}</time>
        {originalUrl && sourceName && (
          <> · <a href={originalUrl} target="_blank" rel="noopener" class="origin-lk">Originally on {sourceName} ↗</a></>
        )}
      </div>
    </header>

    {cover && <img src={cover} alt={title} class="cover" loading="eager" />}

    <div class="prose">
      <Content />
    </div>

    <footer class="post-foot">
      {originalUrl && sourceName && (
        <p class="foot-note">Originally posted on {sourceName}.
          <a href={originalUrl} target="_blank" rel="noopener">Read it there ↗</a>
        </p>
      )}
      <p class="backline"><a href="/writing">← All writing</a></p>
    </footer>
  </article>
</Reading>

<style>
  .backline { font-family: var(--mono); font-size: 12.5px; margin: 0 0 4px; }
  .backline a { color: var(--muted); text-decoration: none; }
  .backline a:hover { color: var(--accent); }

  .post-head { margin: 24px 0 28px; }
  .tags-row { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 16px; }
  .post-title {
    font-family: var(--grot); font-weight: 700; font-size: clamp(28px, 5vw, 42px);
    line-height: 1.12; letter-spacing: -.02em; color: var(--ink); margin: 0 0 14px;
    text-wrap: balance; overflow-wrap: anywhere;
  }
  .post-meta { font-family: var(--mono); font-size: 12.5px; color: var(--faint); }
  .post-meta .origin-lk { color: var(--accent); text-decoration: none; }
  .post-meta .origin-lk:hover { text-decoration: underline; }

  .cover { display: block; width: 100%; height: auto; border: 1px solid var(--hair); margin: 0 0 36px; }

  /* ---- article body ---- */
  .prose { font-family: var(--grot); font-size: 18px; line-height: 1.72; color: var(--ink-2); max-width: 68ch; }
  .prose :global(p) { margin: 0 0 22px; }
  .prose :global(h2) {
    font-family: var(--grot); font-weight: 700; font-size: 24px; line-height: 1.2;
    color: var(--ink); letter-spacing: -.01em; margin: 40px 0 14px;
  }
  .prose :global(h3) { font-family: var(--grot); font-weight: 600; font-size: 19px; color: var(--ink); margin: 30px 0 12px; }
  .prose :global(a) { color: var(--accent); text-decoration: none; border-bottom: 1px solid rgba(31,58,255,.35); }
  .prose :global(a:hover) { border-bottom-color: var(--accent); }
  .prose :global(strong) { color: var(--ink); font-weight: 600; }
  .prose :global(em) { font-style: italic; }
  .prose :global(ul), .prose :global(ol) { margin: 0 0 22px; padding-left: 22px; }
  .prose :global(li) { margin: 0 0 8px; }
  .prose :global(img) { display: block; width: 100%; height: auto; border: 1px solid var(--hair); margin: 28px 0; }
  .prose :global(blockquote) {
    margin: 0 0 24px; padding-left: 20px; border-left: 1px solid var(--hair-2);
    color: var(--muted); font-style: italic;
  }
  .prose :global(code) {
    font-family: var(--mono); font-size: .86em; background: var(--paper-2);
    border: 1px solid var(--hair); border-radius: 2px; padding: 2px 6px;
  }
  .prose :global(pre) {
    background: var(--paper-2); border: 1px solid var(--hair); border-radius: 2px;
    padding: 18px 20px; overflow-x: auto; margin: 0 0 24px;
  }
  .prose :global(pre code) { background: none; border: 0; padding: 0; font-size: 13.5px; }
  .prose :global(hr) { border: 0; border-top: 1px solid var(--hair); margin: 36px 0; }

  .post-foot { margin-top: 48px; padding-top: 24px; border-top: 1px solid var(--hair); }
  .foot-note { font-family: var(--mono); font-size: 13px; color: var(--muted); margin: 0 0 16px; }
  .foot-note a { color: var(--accent); text-decoration: none; margin-left: 4px; }
  .foot-note a:hover { text-decoration: underline; }
</style>
