---
import { roles } from '../data/timeline';
import { ventures } from '../data/ventures';
---
<section id="trajectory" class="section">
  <div class="wrap traj">
    <div data-reveal class="eyebrow">Trajectory</div>
    <h2 data-reveal data-delay="80" class="h-section">Seven years, one arc: from intern to architect.</h2>

    <div id="tl-track" class="tl-track">
      <div class="tl-rail" aria-hidden="true"></div>
      <div id="tl-fill" class="tl-fill" aria-hidden="true"></div>

      {roles.map((r) => (
        <div data-reveal class="tl-item">
          <span class={`tl-dot${r.current ? ' is-current' : ''}`} aria-hidden="true"></span>
          <div class={`tl-period${r.current ? ' is-current' : ''}`}>{r.period}</div>
          <div class="tl-title">
            {r.title}{r.sub && <span class="tl-sub"> {r.sub}</span>}
          </div>
          <p class="tl-body lead">{r.body}</p>
        </div>
      ))}
    </div>

    <!-- ventures founded -->
    <div data-reveal class="ventures">
      <div class="eyebrow" style="margin-bottom:8px">Ventures founded</div>
      <p class="ventures-note lead">Companies and products I founded and helped lead, all running in parallel with the roles above.</p>

      <div class="ventures-list">
        {ventures.map((v) => (
          <div class="venture">
            <div class="venture-year">
              <div class="venture-year-num">{v.year}</div>
              <div class="venture-year-now">→ now</div>
            </div>
            <div class="venture-main">
              <div class="venture-head">
                <span class="venture-name">{v.name}</span>
                <span class="venture-role">{v.role}</span>
              </div>
              <p class="venture-blurb lead">{v.blurb}</p>
            </div>
            <a href={v.link.href} target="_blank" rel="noopener" class="venture-link">{v.link.label}</a>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>

<style>
  .traj { padding-top: 80px; padding-bottom: 40px; }

  .tl-track { position: relative; }
  .tl-rail { position: absolute; left: 7px; top: 8px; bottom: 8px; width: 2px; background: var(--line-faint); }
  .tl-fill { position: absolute; left: 7px; top: 8px; width: 2px; height: 0; background: linear-gradient(var(--gold), var(--gold-lo)); }

  .tl-item { position: relative; padding: 0 0 40px 44px; }
  .tl-item:last-of-type { padding-bottom: 8px; }
  .tl-dot {
    position: absolute; left: 0; top: 5px;
    width: 16px; height: 16px; border-radius: 50%;
    background: #3a3c42; border: 3px solid var(--bg);
  }
  .tl-dot.is-current { background: var(--gold); box-shadow: 0 0 0 4px #c9a86a22; }
  .tl-period { font-family: var(--f-serif); font-size: 15px; color: var(--dim); }
  .tl-period.is-current { color: var(--gold); }
  .tl-title { font-size: 22px; font-weight: 600; color: var(--head-2); margin: 4px 0 8px; }
  .tl-sub { font-size: 13px; color: var(--dim); font-weight: 400; }
  .tl-body { font-size: 16px; line-height: 1.6; color: var(--body); margin: 0; max-width: 680px; }

  .ventures { margin-top: 56px; }
  .ventures-note { font-size: 15px; line-height: 1.55; color: var(--body-2); margin: 0 0 30px; max-width: 560px; font-style: italic; }
  .ventures-list { border-top: 1px solid var(--line); }
  .venture {
    display: grid;
    grid-template-columns: 92px 1fr auto;
    gap: 28px;
    align-items: center;
    padding: 24px 0;
    border-bottom: 1px solid var(--line);
  }
  .venture-year-num { font-family: var(--f-serif); font-size: 34px; font-weight: 300; line-height: 1; color: #d9d3c6; }
  .venture-year-now { font-family: var(--f-mono); font-size: 8.5px; letter-spacing: .5px; color: var(--faint); margin-top: 5px; }
  .venture-head { display: flex; align-items: center; gap: 11px; margin-bottom: 6px; flex-wrap: wrap; }
  .venture-name { font-size: 19px; font-weight: 600; color: var(--head-2); }
  .venture-role {
    font-family: var(--f-mono); font-size: 8.5px; letter-spacing: 1.5px; color: var(--gold);
    border: 1px solid #2a2210; background: #15110a; border-radius: 20px; padding: 3px 8px;
  }
  .venture-blurb { font-size: 14.5px; line-height: 1.5; color: var(--body-2); margin: 0; max-width: 520px; }
  .venture-link {
    font-family: var(--f-mono); font-size: 11px; letter-spacing: .5px; color: var(--gold);
    text-decoration: none; border: 1px solid #c9a86a44; border-radius: 3px; padding: 9px 17px;
    white-space: nowrap; transition: background .25s, color .25s;
  }
  .venture-link:hover { background: var(--gold); color: var(--bg); }

  @media (max-width: 639px) {
    .venture {
      grid-template-columns: 64px 1fr;
      gap: 16px 18px;
    }
    .venture-year-num { font-size: 26px; }
    .venture-link { grid-column: 2; justify-self: start; }
  }
</style>
