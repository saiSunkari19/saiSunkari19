---
import { CALENDLY_URL } from '../data/site';

const email = 'saisunkari19@protonmail.com';
const socials = [
  { href: 'https://github.com/saiSunkari19', label: 'GitHub' },
  { href: 'https://linkedin.com/in/saisunkari19', label: 'LinkedIn' },
  { href: 'https://twitter.com/saisunkari19', label: 'Twitter / X' },
];
---
<section id="contact" class="section contact">
  <div class="glow" aria-hidden="true"></div>
  <div class="wrap contact-inner">
    <div data-reveal class="eyebrow">Let's build</div>
    <h2 data-reveal data-delay="80" class="contact-h">Have a protocol to architect or a team to lead?</h2>
    <p data-reveal data-delay="140" class="contact-lead lead">
      I only take on a handful of architecture, advisory and fractional-leadership engagements at a time,
      so the ones I say yes to get my full attention. If that sounds like what you need, I'd genuinely
      love to hear what you're building.
    </p>
    <div data-reveal data-delay="200" class="contact-cta">
      <a href={CALENDLY_URL} target="_blank" rel="noopener" class="btn btn-gold">Book a call</a>
      <a href={`mailto:${email}`} class="btn btn-ghost">{email}</a>
    </div>
    <div data-reveal data-delay="260" class="contact-socials">
      {socials.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" class="social">{s.label}</a>
      ))}
    </div>
    <div class="footer">
      <span>© 2026 Sai Krishna Sunkari</span>
      <span>Hyderabad, India · UTC+5:30</span>
    </div>
  </div>
</section>

<style>
  .contact { margin-top: 60px; border-top: 1px solid var(--line); background: var(--bg-2); }
  .glow {
    position: absolute; bottom: 0; left: 50%; transform: translateX(-50%);
    width: 620px; height: 300px; max-width: 100%;
    background: radial-gradient(closest-side, #c9a86a26, transparent 70%);
    filter: blur(20px); pointer-events: none;
  }
  .contact-inner { padding-top: 90px; padding-bottom: 70px; position: relative; text-align: center; }
  .contact-h {
    font-family: var(--f-serif); font-weight: 300; font-size: clamp(34px, 6vw, 52px);
    line-height: 1.05; letter-spacing: -1px; color: var(--head); margin: 0 auto 24px; max-width: 680px;
  }
  .contact-lead { font-size: 18px; line-height: 1.6; color: var(--lead); margin: 0 auto 38px; max-width: 520px; }
  .contact-cta { display: flex; gap: 14px; justify-content: center; flex-wrap: wrap; }
  .btn-gold { padding: 14px 30px; }
  .btn-ghost { padding: 14px 26px; }

  .contact-socials { display: flex; gap: 28px; justify-content: center; margin-top: 46px; font-size: 13px; flex-wrap: wrap; }
  .social { color: var(--nav); text-decoration: none; transition: color .3s; }
  .social:hover { color: var(--gold); }

  .footer {
    margin-top: 44px; padding-top: 26px; border-top: 1px solid var(--line);
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    font-family: var(--f-mono); font-size: 11px; color: var(--faint); letter-spacing: .5px;
  }
  @media (max-width: 560px) {
    .footer { flex-direction: column; gap: 8px; text-align: center; }
  }
</style>
