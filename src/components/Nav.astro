---
// Topline header for the Directory layout: identity on the left, a
// Writing link + the always-present "Book a call" on the right, a hairline.
import { CALENDLY_URL } from '../data/site';

const path = Astro.url.pathname;
const onWriting = path.startsWith('/writing');
---
<header>
  <div class="topline">
    <a class="who" href="/" aria-label="Sai Krishna Sunkari — home">
      <b>Sai Krishna Sunkari</b> — Blockchain Architect · Builder &amp; Advisor
    </a>
    <nav aria-label="Primary">
      <a class="nav-lk" href="/writing" aria-current={onWriting ? 'page' : undefined}>Writing</a>
      <a class="avail" href={CALENDLY_URL} target="_blank" rel="noopener">
        <span class="dot" aria-hidden="true"></span>AVAILABLE — <span class="lk">BOOK&nbsp;A&nbsp;CALL</span>
      </a>
    </nav>
  </div>
  <hr class="rule" />
</header>
