---
const lenses = [
  {
    n: '01',
    title: 'Architecture',
    body: 'I design the cross-chain protocols, DeFi primitives and token economics your product runs on, across EVM, Cosmos SDK app-chains, Sui, Aptos and Movement.',
  },
  {
    n: '02',
    title: 'Strategy',
    body: 'I help you weigh L1/L2 trade-offs, threat-model early and hold audit-ready standards, so security and decentralization never cost you your speed to market.',
  },
  {
    n: '03',
    title: 'Leadership',
    body: 'I own roadmap, hiring and delivery from 0→1 through scale, and keep the team steady across smart contracts, backend and AI-agent layers.',
  },
];
---
<section id="approach" class="section">
  <div class="wrap approach">
    <div data-reveal class="eyebrow">How I work</div>
    <h2 data-reveal data-delay="80" class="h-section approach-h">Three lenses I bring to everything I build with you.</h2>
    <div class="cards">
      {lenses.map((l, i) => (
        <div data-reveal data-delay={i * 100} class="card">
          <div class="card-n">{l.n}</div>
          <div class="card-title">{l.title}</div>
          <p class="card-body lead">{l.body}</p>
        </div>
      ))}
    </div>
  </div>
</section>

<style>
  .approach { padding-top: 88px; padding-bottom: 30px; }
  .approach-h { max-width: 640px; }
  .cards {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .card { background: var(--bg); padding: 34px 32px; }
  .card-n { font-family: var(--f-serif); font-size: 34px; color: var(--line-faint); line-height: 1; margin-bottom: 20px; }
  .card-title { font-size: 18px; font-weight: 600; color: var(--head-2); margin-bottom: 12px; }
  .card-body { font-size: 15px; line-height: 1.6; color: var(--body); margin: 0; }

  @media (max-width: 900px) { .cards { grid-template-columns: 1fr; } }
</style>
