---
import { Image } from 'astro:assets';
import { activities, activitiesIntro } from '../data/activities';

const multi = activities.length > 1;
---
<section id="beyond" class="section">
  <div class="wrap beyond">
    <div class="beyond-head">
      <div>
        <div data-reveal class="eyebrow">Beyond the work</div>
        <h2 data-reveal data-delay="80" class="h-section beyond-h">Off the keyboard.</h2>
      </div>
      <p data-reveal data-delay="120" class="beyond-intro">{activitiesIntro}</p>
    </div>

    <div data-reveal data-delay="140" class="card" data-carousel>
      <div class="stage">
        {multi && (
          <button class="arrow prev" data-prev aria-label="Previous">‹</button>
        )}
        {activities.map((a, i) => (
          <div class="slide" data-slide data-active={i === 0 ? '' : null}>
            {a.image ? (
              <Image src={a.image} alt={a.alt ?? a.title} width={680} height={453} loading={i === 0 ? 'eager' : 'lazy'} />
            ) : (
              <div class="ph" aria-hidden="true"><span>{a.title}</span></div>
            )}
          </div>
        ))}
        {multi && (
          <button class="arrow next" data-next aria-label="Next">›</button>
        )}
      </div>

      <div class="body">
        {activities.map((a, i) => (
          <div class="caption" data-caption data-active={i === 0 ? '' : null}>
            <div class="row">
              <span class="pill">{a.badge}</span>
              <span class="meta">{a.meta}</span>
            </div>
            <div class="title">{a.title}</div>
            <p class="desc lead">{a.desc}</p>
          </div>
        ))}

        {multi && (
          <div class="dots" role="tablist" aria-label="Activities">
            {activities.map((a, i) => (
              <button class="dot" data-dot={i} data-active={i === 0 ? '' : null}
                      role="tab" aria-label={a.title}></button>
            ))}
          </div>
        )}
      </div>
    </div>
  </div>
</section>

<style>
  .beyond { padding-top: 80px; padding-bottom: 40px; }
  .beyond-head {
    display: grid; grid-template-columns: 1fr 360px; gap: 48px; align-items: start;
    margin-bottom: 36px;
  }
  .beyond-h { margin: 0; }
  .beyond-intro {
    font-family: var(--f-read); font-style: italic; font-weight: 300; font-size: 17px;
    line-height: 1.5; color: var(--body); margin: 6px 0 0; text-align: right;
  }

  .card {
    max-width: 620px;
    background: var(--card); border: 1px solid var(--line); border-radius: 6px; overflow: hidden;
  }

  .stage { position: relative; aspect-ratio: 3 / 2; background: var(--bg-3); }
  .slide { position: absolute; inset: 0; opacity: 0; transition: opacity .4s ease; pointer-events: none; }
  .slide[data-active] { opacity: 1; pointer-events: auto; }
  .slide img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .ph {
    width: 100%; height: 100%; display: flex; align-items: center; justify-content: center;
    background:
      radial-gradient(120% 120% at 50% 0%, #15161b, var(--bg-3));
  }
  .ph span {
    font-family: var(--f-mono); font-size: 11px; letter-spacing: 1.5px; text-transform: uppercase;
    color: var(--faint); border: 1px dashed var(--line-2); border-radius: 30px; padding: 8px 16px;
  }

  .arrow {
    position: absolute; top: 50%; transform: translateY(-50%); z-index: 2;
    width: 40px; height: 40px; border-radius: 50%; cursor: pointer;
    display: flex; align-items: center; justify-content: center;
    font-size: 22px; line-height: 1; color: var(--head);
    background: rgba(10, 11, 14, .55); border: 1px solid rgba(255, 255, 255, .12);
    backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px);
    transition: background .25s, border-color .25s;
  }
  .arrow:hover { background: rgba(10, 11, 14, .8); border-color: var(--gold); }
  .arrow.prev { left: 14px; }
  .arrow.next { right: 14px; }

  .body { position: relative; padding: 22px 24px 20px; }
  .caption { display: none; }
  .caption[data-active] { display: block; }
  .row { display: flex; justify-content: space-between; align-items: center; gap: 8px; margin-bottom: 12px; }
  .pill {
    font-family: var(--f-mono); font-size: 9.5px; letter-spacing: 1.5px; color: var(--gold);
    border: 1px solid #c9a86a44; border-radius: 20px; padding: 4px 11px;
  }
  .meta { font-family: var(--f-mono); font-size: 10px; letter-spacing: 1px; color: var(--gold); text-align: right; }
  .title { font-size: 22px; font-weight: 600; color: var(--head-2); margin-bottom: 9px; }
  .desc { font-size: 15px; line-height: 1.55; color: var(--body-2); margin: 0; }

  .dots { display: flex; gap: 8px; margin-top: 20px; }
  .dot {
    width: 8px; height: 8px; border-radius: 30px; padding: 0; cursor: pointer;
    background: #3a3c42; border: 0; transition: width .25s, background .25s;
  }
  .dot[data-active] { width: 22px; background: var(--gold); }

  @media (max-width: 760px) {
    .beyond-head { grid-template-columns: 1fr; gap: 14px; }
    .beyond-intro { text-align: left; }
    .card { max-width: none; }
  }
</style>

<script>
  // Self-contained carousel: cross-fades the image and swaps the caption.
  document.querySelectorAll<HTMLElement>('[data-carousel]').forEach((root) => {
    const slides = [...root.querySelectorAll<HTMLElement>('[data-slide]')];
    const caps = [...root.querySelectorAll<HTMLElement>('[data-caption]')];
    const dots = [...root.querySelectorAll<HTMLElement>('[data-dot]')];
    const n = slides.length;
    if (n < 2) return;
    let i = 0;

    const show = (next: number) => {
      i = (next + n) % n;
      slides.forEach((el, k) => el.toggleAttribute('data-active', k === i));
      caps.forEach((el, k) => el.toggleAttribute('data-active', k === i));
      dots.forEach((el, k) => el.toggleAttribute('data-active', k === i));
    };

    root.querySelector('[data-prev]')?.addEventListener('click', () => show(i - 1));
    root.querySelector('[data-next]')?.addEventListener('click', () => show(i + 1));
    dots.forEach((d, k) => d.addEventListener('click', () => show(k)));

    // Keyboard arrows when the carousel has focus within.
    root.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowLeft') show(i - 1);
      if (e.key === 'ArrowRight') show(i + 1);
    });
  });
</script>
