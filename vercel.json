{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "astro",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "redirects": [
    { "source": "/sitemap.xml", "destination": "/sitemap-index.xml", "permanent": true },
    { "source": "/gh", "destination": "/?utm_source=github&utm_medium=profile&utm_campaign=portfolio", "permanent": false },
    { "source": "/x", "destination": "/?utm_source=twitter&utm_medium=social&utm_campaign=portfolio", "permanent": false },
    { "source": "/li", "destination": "/?utm_source=linkedin&utm_medium=social&utm_campaign=portfolio", "permanent": false },
    { "source": "/rd", "destination": "/?utm_source=reddit&utm_medium=social&utm_campaign=portfolio", "permanent": false },
    { "source": "/tl", "destination": "/?utm_source=tarulease&utm_medium=referral&utm_campaign=portfolio", "permanent": false },
    { "source": "/mk", "destination": "/?utm_source=myselfkart&utm_medium=referral&utm_campaign=portfolio", "permanent": false }
  ],
  "rewrites": [
    { "source": "/admin", "destination": "/admin/index.html" }
  ]
}
